<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:gravity="center"
android:orientation="vertical"
android:padding="24dp">


<Button
android:id="@+id/btnCpu"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Testare CPU" />


<Button
android:id="@+id/btnMemory"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Testare Memorie"
android:layout_marginTop="12dp" />



<Button
android:id="@+id/btnGpu"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Testare GPU"
android:layout_marginTop="12dp" />


<Button
android:id="@+id/btnSystem"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Detalii Sistem"
android:layout_marginTop="12dp" />


<Button
android:id="@+id/btnIntegral"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Testare Integrala"
android:layout_marginTop="12dp" />

</LinearLayout>